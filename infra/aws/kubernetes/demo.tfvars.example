# Preset đã chốt cho final: hai worker c6i.xlarge (4 vCPU/8 GiB mỗi máy), ghép Data Platform c6i.2xlarge => 16 vCPU/32 GiB.
# Hai worker: dự phòng mức máy cho app có >= 2 replica. Cùng một AZ (vì EBS) => chưa chịu được sự cố AZ.
region              = "ap-southeast-2"
name_prefix         = "platform"
data_platform_state = "../terraform/terraform.tfstate"
node_instance_types = ["c6i.xlarge"]
node_desired_size   = 2
node_min_size       = 0
node_max_size       = 2
node_disk_gb        = 80
# Đã dùng hết quota 16 vCPU: DEFAULT cần tạo node mới trước => vượt quota. MINIMAL thay từng node một;
# node kia vẫn phục vụ nếu app có replica ở đó.
node_update_strategy = "MINIMAL"
single_az_workers    = true
# Điền IAM role ARN và CIDR quản trị thực trước plan.
# 1.37 = bản mới nhất còn standard support (kiểm 2026-10-26), trùng bản kind local đã chạy mọi workload.
kubernetes_version = "1.37"
# admin_role_arn     = "arn:aws:iam::ACCOUNT:role/PATH/ROLE"
# api_allowed_cidrs  = ["ADMIN_IP/32"]
