# Cấu hình riêng trên VM; file 0600, secret lấy từ biến Ansible Vault.
COMPOSE_FILE=docker-compose.yml:docker-compose.aws.yml{% if (aws_runtime_profile | default('standard')) == 'performance' %}:docker-compose.aws-performance.yml{% endif %}

PLATFORM_RUNTIME_PROFILE={{ aws_runtime_profile | default('standard') | quote }}
PLATFORM_STORAGE=s3
AWS_REGION={{ aws_region | quote }}
# IP riêng VPC của EC2: MLflow nghe ở đây cho pod EKS (SG chỉ mở từ SG cluster).
PLATFORM_PRIVATE_IP={{ ansible_default_ipv4.address | quote }}
RAW_BUCKET={{ raw_bucket | quote }}
LAKEHOUSE_BUCKET={{ lakehouse_bucket | quote }}
WAREHOUSE_NAME={{ warehouse_name | quote }}
LAKEKEEPER_CATALOG_URI=http://lakekeeper:8181/catalog
PLATFORM_CONTRACTS_DIR=/opt/contracts
PLATFORM_SPARK_PACKAGES_AWS={{ spark_packages_aws | quote }}
# ponytail: IP riêng một node EKS (NodePort vào node nào cũng tới Redis); node bị thay thì đổi
# biến feast_redis, prod dùng NLB nội bộ cho địa chỉ cố định.
PLATFORM_FEAST_REDIS={{ feast_redis | default('10.42.0.121:30379') | quote }}
PLATFORM_DATASET_NAME={{ source_dataset_name | quote }}
PLATFORM_ORDER_LIFECYCLE_CUTOFF={{ source_cutoff | quote }}
POSTGRES_USER={{ postgres_user | quote }}
POSTGRES_PASSWORD={{ postgres_password | quote }}
POSTGRES_DB={{ postgres_db | quote }}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
LAKEKEEPER_ENCRYPTION_KEY={{ lakekeeper_encryption_key | quote }}
AIRFLOW_UID={{ airflow_uid }}
# Airflow operator cũ còn yêu cầu Connection MinIO: placeholder vô hiệu, không phải key AWS.
MINIO_ROOT_USER=unused-aws
MINIO_ROOT_PASSWORD=unused-aws
MINIO_BUCKET=unused-aws
GENERATOR_CONFIG=configs/default.yaml
