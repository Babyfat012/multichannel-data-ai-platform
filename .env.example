# Sao chép thành .env rồi đổi giá trị. .env không được commit.
MINIO_ROOT_USER=fsds
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=fsds
POSTGRES_USER=fsds
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sources
# Cấu hình generator chạy trong Compose: configs/small.yaml hoặc configs/default.yaml
GENERATOR_CONFIG=configs/small.yaml
# Cổng mở ra máy host, đổi nếu đã có chương trình khác dùng
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
KAFKA_PORT=9094
# Tốc độ phát Stream: 1 là đúng nhịp (khoảng 40 phút cho 30 ngày), 60 là nhanh gấp 60 lần
STREAM_SPEED=1
