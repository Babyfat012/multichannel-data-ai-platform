# Sao chép thành .env rồi đổi giá trị. .env không được commit.
MINIO_ROOT_USER=fsds
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=fsds
POSTGRES_USER=fsds
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sources
# Cấu hình generator chạy trong Compose: configs/small.yaml hoặc configs/default.yaml
GENERATOR_CONFIG=configs/small.yaml
# Cổng mở ra máy host, đổi nếu đã có chương trình khác dùng
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
KAFKA_PORT=9094
# Tốc độ phát Stream: 1 là đúng nhịp (khoảng 40 phút cho 30 ngày), 60 là nhanh gấp 60 lần
STREAM_SPEED=1
# Spark (profile spark). Đổi SPARK_WORKER_MEMORY xuống 1g khi chạy cùng Airflow cho đỡ chật RAM
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_MEM_LIMIT=2560m
SPARK_WORKER_CORES=2
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8080
# Lakekeeper (profile catalog/spark): khoá mã hoá secret trong DB catalog, đổi thành chuỗi riêng
LAKEKEEPER_ENCRYPTION_KEY=change-me-lakekeeper-key
LAKEKEEPER_PORT=8181
