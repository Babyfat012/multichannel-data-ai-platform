# Image chưa tối ưu, chỉ để đo dung lượng so với Dockerfile ở gốc repo (xem docs/Docker.md).
# Một stage, base image đầy đủ, pip giữ cache, copy cả repo.
# Thư viện cài từ requirements.lock (xuất từ uv.lock, cùng phiên bản và hash) để hai image có
# CÙNG bộ thư viện; khác nhau chỉ ở kỹ thuật build. Project cài sau với --no-deps để pip không
# tự chọn lại phiên bản thư viện.
FROM python:3.12
WORKDIR /app
COPY . .
RUN pip install -r requirements.lock && pip install --no-deps .
ENTRYPOINT ["python", "-m", "generator"]
