# KServe predictor return-risk, model-inside-image: file model nằm trong image, không tải lúc chạy.
# Dựng trên platform-train (đã có LightGBM + Feast + ml/) để dùng chung lớp. Build context do
# scripts/run/deploy_return_risk.sh dựng: ml/ + model.lgb tải từ MLflow alias production.
ARG BASE_IMAGE=platform-train:0.1.0
FROM ${BASE_IMAGE}
USER root
RUN pip install --no-cache-dir "kserve==0.21.0"
ARG MODEL_VERSION=unknown
COPY ml /opt/ml/ml
COPY model.lgb /opt/model/model.lgb
ENV MODEL_VERSION=${MODEL_VERSION} MODEL_PATH=/opt/model/model.lgb
USER 65534
ENTRYPOINT ["python", "-m", "ml.serve"]
