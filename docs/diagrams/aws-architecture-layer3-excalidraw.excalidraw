    {
      "id": "aws-architecture-layer3-337",
      "type": "text",
      "x": 40,
      "y": 1989,
      "width": 628.1171875,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#4f5d75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 1.1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4Q",
      "roundness": null,
      "seed": 42800,
      "version": 2,
      "versionNonce": 1317920682,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793456626923,
      "link": null,
      "locked": false,
      "text": "Hosts HTTPS: api., agent., grafana., traces., metrics., registry. + <ip>.sslip.io; UI basic auth, API rate limit 50r/s.",
      "originalText": "Hosts HTTPS: api., agent., grafana., traces., metrics., registry. + <ip>.sslip.io; UI basic auth, API rate limit 50r/s.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aws-architecture-layer3-338",
      "type": "text",
      "x": 40,
      "y": 2011,
      "width": 827.5718994140625,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#4f5d75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 1.1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4R",
      "roundness": null,
      "seed": 42927,
      "version": 2,
      "versionNonce": 293652470,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793456626923,
      "link": null,
      "locked": false,
      "text": "Feast / fastembed là thư viện. RAG: EC2 IAM role → S3 → pgvector EKS :30432 qua IP riêng. A/B là route cấu hình, không thêm replica B mặc định.",
      "originalText": "Feast / fastembed là thư viện. RAG: EC2 IAM role → S3 → pgvector EKS :30432 qua IP riêng. A/B là route cấu hình, không thêm replica B mặc định.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aws-architecture-layer3-339",
      "type": "text",
      "x": 30,
      "y": 2219,
      "width": 691.5264892578125,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#4f5d75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 1.1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4S",
      "roundness": null,
      "seed": 43054,
      "version": 2,
      "versionNonce": 1506302570,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793456626923,
      "link": null,
      "locked": false,
      "text": "Quy ước: mũi tên = dữ liệu; gọi không kèm dữ liệu hướng bên gọi → bên được gọi. Prometheus pull, mũi tên biểu diễn metric trả về.",
      "originalText": "Quy ước: mũi tên = dữ liệu; gọi không kèm dữ liệu hướng bên gọi → bên được gọi. Prometheus pull, mũi tên biểu diễn metric trả về.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aws-architecture-layer3-340",
      "type": "text",
      "x": 30,
      "y": 2241,
      "width": 682.421875,
      "height": 13.75,
      "angle": 0,
      "strokeColor": "#4f5d75",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.3,
      "strokeStyle": "solid",
      "roughness": 1.1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4T",
      "roundness": null,
      "seed": 43181,
      "version": 2,
      "versionNonce": 1230002486,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793456626923,
      "link": null,
      "locked": false,
      "text": "Vòng tròn = bước theo luồng; nét đứt = cấp TLS phụ; hộp nét đứt = hỗ trợ dùng chung. EC2 quản trị bằng SSM, không mở SSH.",
      "originalText": "Vòng tròn = bước theo luồng; nét đứt = cấp TLS phụ; hộp nét đứt = hỗ trợ dùng chung. EC2 quản trị bằng SSM, không mở SSH.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
